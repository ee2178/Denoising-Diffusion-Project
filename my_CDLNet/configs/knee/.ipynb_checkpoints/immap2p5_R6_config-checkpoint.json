{
"type": "LPDSNet",
"model": {
	"adaptive": true,
    "e2e_diff" : true,
    "K": 30,
	"M": 169,
	"C": 1,
	"P": 7,
	"s": 2
},
"paths": {
	"save": "trained_nets/knee/LPDS_ImMAP2p5_R6_kspaceWHITENED_noSSDUMasking_sigmaScaleON_noiseCOSINE",
	"ckpt": null
},
"train": {
	"loaders": {
		"batch_size": 1,
		"crop_size": 256,
		"trn_path_list": ["../../datasets/fastmri_preprocessed/knee_coil_combined/pd/train"],
		"val_path_list": ["../../datasets/fastmri_preprocessed/knee_coil_combined/pd/val"],
		"tst_path_list": ["../../datasets/fastmri_preprocessed/knee_coil_combined/pd/test"],
		"trn_kspace_path_list": ["../../datasets/fastmri/knee/multicoil_train"],
        "val_kspace_path_list": ["../../datasets/fastmri/knee/multicoil_val"],
        "tst_kspace_path_list": ["../../datasets/fastmri/knee/multicoil_test_v2"],
        "start_slice": 15,
        "end_slice": 27,
        "scaling_fac":5e3,
        "num_workers": 14,
        "modality": "knee"
	},
	"fit": {
		"epochs": null,
		"noise_std": [0.00, 0.05],
		"image_noise_std": [0.01, 1],
        "val_freq": 50,
		"save_freq": 5,
		"backtrack_thresh": 5,
		"verbose": true,
		"clip_grad": 5e-1,
        "blur": false,
        "pix_width":[1, 10],
        "loss_type":"complex-mse",
		"demosaic": false,
		"mcsure": false,
        "x_init":true,
        "sigma_scaling":true,
        "ssdu_masking":false,
        "ssdu_base_accel":2, 
        "noise_dist": "cosine",
	    "noise_log_base": 100,
        "e2enet_args_path":"trained_nets/knee/LPDS_MRI_Recon_R6_nl1nl2Loss/args.json",
        "denoiser_args_path":"trained_nets/knee/LPDSNet/args.json",
        "init_type": null,
        "max_steps": 300000,
        "val_every": 5000,
        "save_every": 5000
    },
	"opt": {
		"lr": 5e-4
	},
	"sched": {
        "type":"cosine",
        "params":{
		    "eta_min": 1e-6,
		    "T_max": 300000
        }
	}
},
"mri":{
    "R": 6,
    "acs_lines" : 20,
    "kspace_type": "measurement",
    "whiten_kspace": true
}
}
