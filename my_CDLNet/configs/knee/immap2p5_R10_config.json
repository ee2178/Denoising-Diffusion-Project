        "denoiser_args_path":"trained_nets/knee/LPDSNet/args.json",
        "init_type": null,
        "max_steps": 300000,
        "val_every": 5000,
        "save_every": 5000
    },
	"opt": {
		"lr": 5e-4
	},
	"sched": {
		"gamma": 0.95,
		"step_size": 2500
	}
},
"mri":{
    "R": 10,
    "acs_lines" : 20
}
