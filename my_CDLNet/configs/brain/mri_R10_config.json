{
"type": "LPDSNetBase",
"model": {
	"adaptive": true,
    "e2e_diff" : true,
    "K": 30,
	"M": 169,
	"C": 1,
	"P": 7,
	"s": 2
},
"paths": {
	"save": "trained_nets/brain/LPDS_MRI_Recon_R10_nl1nl2Loss",
	"ckpt": null
},
"train": {
	"loaders": {
		"batch_size": 1,
		"crop_size": 256,
        "trn_path_list": ["../../datasets/fastmri_preprocessed/brain_T2W_coil_combined/train"],
		"val_path_list": ["../../datasets/fastmri_preprocessed/brain_T2W_coil_combined/val"],
		"tst_path_list": ["../../datasets/fastmri_preprocessed/brain_T2W_coil_combined/test"],
		"trn_kspace_path_list": ["../../datasets/fastmri/brain/multicoil_train"],
        "val_kspace_path_list": ["../../datasets/fastmri/brain/multicoil_val"],
        "tst_kspace_path_list": ["../../datasets/fastmri/brain/multicoil_test"],
        "start_slice": 0,
        "end_slice": 8,
        "scaling_fac":2e3,
        "num_workers": 14,
        "modality": "brain"
	},
	"fit": {
		"epochs": null,
		"noise_std": [0.01, 0.02],
		"image_noise_std": [0.001, 0.5],
        "val_freq": 50,
		"save_freq": 5,
		"backtrack_thresh": 5,
		"verbose": true,
		"clip_grad": 5e-1,
        "loss_type":"magnitude-nl1-nl2",
		"demosaic": false,
		"mcsure": false,
        "x_init":false,
        "noise_dist": "uniform",
	    "denoiser_args_path":"eval_config.json",
        "max_steps": 300000,
        "val_every": 2000,
        "save_every": 5000
    },
	"opt": {
		"lr": 5e-4
	},
	"sched": {
		"gamma": 0.95,
		"step_size": 2500
	}
},
"mri":{
    "R": 10,
    "acs_lines" : 24
}
}
